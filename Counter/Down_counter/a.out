#! /usr/local/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/local/lib/ivl/system.vpi";
:vpi_module "/usr/local/lib/ivl/vhdl_sys.vpi";
:vpi_module "/usr/local/lib/ivl/vhdl_textio.vpi";
:vpi_module "/usr/local/lib/ivl/v2005_math.vpi";
:vpi_module "/usr/local/lib/ivl/va_math.vpi";
:vpi_module "/usr/local/lib/ivl/v2009.vpi";
S_0x1ac917f0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x1ac91980 .scope module, "stimulus" "stimulus" 3 3;
 .timescale -9 -12;
v0x1aca42e0_0 .var "CLK", 0 0;
v0x1aca43b0_0 .net "Q", 3 0, v0x1aca40b0_0;  1 drivers
v0x1aca4480_0 .var "RST", 0 0;
S_0x1ac6c580 .scope module, "count" "down_counter" 3 7, 4 3 0, S_0x1ac91980;
 .timescale -9 -12;
    .port_info 0 /OUTPUT 4 "q";
    .port_info 1 /INPUT 1 "clk";
    .port_info 2 /INPUT 1 "rst";
v0x1ac6c7b0_0 .net "clk", 0 0, v0x1aca42e0_0;  1 drivers
v0x1aca40b0_0 .var "q", 3 0;
v0x1aca4190_0 .net "rst", 0 0, v0x1aca4480_0;  1 drivers
E_0x1ac91f90 .event posedge, v0x1ac6c7b0_0;
    .scope S_0x1ac6c580;
T_0 ;
    %pushi/vec4 15, 0, 4;
    %store/vec4 v0x1aca40b0_0, 0, 4;
    %end;
    .thread T_0;
    .scope S_0x1ac6c580;
T_1 ;
    %wait E_0x1ac91f90;
    %load/vec4 v0x1aca4190_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_1.0, 8;
    %pushi/vec4 15, 0, 4;
    %assign/vec4 v0x1aca40b0_0, 0;
    %jmp T_1.1;
T_1.0 ;
    %load/vec4 v0x1aca40b0_0;
    %subi 1, 0, 4;
    %assign/vec4 v0x1aca40b0_0, 0;
T_1.1 ;
    %jmp T_1;
    .thread T_1;
    .scope S_0x1ac91980;
T_2 ;
    %vpi_call/w 3 11 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call/w 3 12 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x1ac91980 {0 0 0};
    %end;
    .thread T_2;
    .scope S_0x1ac91980;
T_3 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1aca42e0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x1aca4480_0, 0, 1;
    %end;
    .thread T_3;
    .scope S_0x1ac91980;
T_4 ;
    %delay 10000, 0;
    %load/vec4 v0x1aca42e0_0;
    %inv;
    %store/vec4 v0x1aca42e0_0, 0, 1;
    %jmp T_4;
    .thread T_4;
    .scope S_0x1ac91980;
T_5 ;
    %vpi_call/w 3 25 "$monitor", $time, " Q=%b\012", v0x1aca43b0_0 {0 0 0};
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1aca4480_0, 0, 1;
    %delay 305000, 0;
    %vpi_call/w 3 27 "$finish" {0 0 0};
    %end;
    .thread T_5;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "testbench.sv";
    "design.sv";

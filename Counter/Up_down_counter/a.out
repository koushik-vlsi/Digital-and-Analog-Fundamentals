#! /usr/local/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/local/lib/ivl/system.vpi";
:vpi_module "/usr/local/lib/ivl/vhdl_sys.vpi";
:vpi_module "/usr/local/lib/ivl/vhdl_textio.vpi";
:vpi_module "/usr/local/lib/ivl/v2005_math.vpi";
:vpi_module "/usr/local/lib/ivl/va_math.vpi";
:vpi_module "/usr/local/lib/ivl/v2009.vpi";
S_0x3c445580 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x3c445710 .scope module, "stimulus" "stimulus" 3 3;
 .timescale -9 -12;
v0x3c47fc90_0 .net "A", 4 0, v0x3c46bdf0_0;  1 drivers
v0x3c47fd70_0 .var "CLK", 0 0;
v0x3c47fe40_0 .net "Q", 3 0, v0x3c47fa30_0;  1 drivers
v0x3c47ff40_0 .var "RST", 0 0;
S_0x3c46bba0 .scope module, "count" "up_down_counter" 3 8, 4 3 0, S_0x3c445710;
 .timescale -9 -12;
    .port_info 0 /OUTPUT 4 "q";
    .port_info 1 /OUTPUT 5 "a";
    .port_info 2 /INPUT 1 "rst";
    .port_info 3 /INPUT 1 "clk";
v0x3c46bdf0_0 .var "a", 4 0;
v0x3c47f970_0 .net "clk", 0 0, v0x3c47fd70_0;  1 drivers
v0x3c47fa30_0 .var "q", 3 0;
v0x3c47fb20_0 .net "rst", 0 0, v0x3c47ff40_0;  1 drivers
E_0x3c46cc60 .event posedge, v0x3c47f970_0;
    .scope S_0x3c46bba0;
T_0 ;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x3c47fa30_0, 0, 4;
    %pushi/vec4 0, 0, 5;
    %store/vec4 v0x3c46bdf0_0, 0, 5;
    %end;
    .thread T_0;
    .scope S_0x3c46bba0;
T_1 ;
    %wait E_0x3c46cc60;
    %load/vec4 v0x3c47fb20_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_1.0, 8;
    %pushi/vec4 0, 0, 4;
    %assign/vec4 v0x3c47fa30_0, 0;
    %jmp T_1.1;
T_1.0 ;
    %load/vec4 v0x3c46bdf0_0;
    %addi 1, 0, 5;
    %store/vec4 v0x3c46bdf0_0, 0, 5;
    %load/vec4 v0x3c46bdf0_0;
    %pad/u 32;
    %cmpi/u 15, 0, 32;
    %flag_or 5, 4;
    %jmp/0xz  T_1.2, 5;
    %load/vec4 v0x3c47fa30_0;
    %addi 1, 0, 4;
    %assign/vec4 v0x3c47fa30_0, 0;
    %jmp T_1.3;
T_1.2 ;
    %load/vec4 v0x3c46bdf0_0;
    %pad/u 32;
    %cmpi/u 15, 0, 32;
    %flag_or 5, 4; GT is !LE
    %flag_inv 5;
    %flag_get/vec4 5;
    %jmp/0 T_1.6, 5;
    %load/vec4 v0x3c46bdf0_0;
    %pad/u 32;
    %cmpi/u 30, 0, 32;
    %flag_get/vec4 4;
    %flag_get/vec4 5;
    %or;
    %and;
T_1.6;
    %flag_set/vec4 8;
    %jmp/0xz  T_1.4, 8;
    %load/vec4 v0x3c47fa30_0;
    %subi 1, 0, 4;
    %assign/vec4 v0x3c47fa30_0, 0;
    %jmp T_1.5;
T_1.4 ;
    %pushi/vec4 0, 0, 5;
    %store/vec4 v0x3c46bdf0_0, 0, 5;
T_1.5 ;
T_1.3 ;
T_1.1 ;
    %jmp T_1;
    .thread T_1;
    .scope S_0x3c445710;
T_2 ;
    %vpi_call/w 3 12 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call/w 3 13 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x3c445710 {0 0 0};
    %end;
    .thread T_2;
    .scope S_0x3c445710;
T_3 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x3c47fd70_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x3c47ff40_0, 0, 1;
    %end;
    .thread T_3;
    .scope S_0x3c445710;
T_4 ;
    %delay 10000, 0;
    %load/vec4 v0x3c47fd70_0;
    %inv;
    %store/vec4 v0x3c47fd70_0, 0, 1;
    %jmp T_4;
    .thread T_4;
    .scope S_0x3c445710;
T_5 ;
    %vpi_call/w 3 27 "$monitor", $time, " A =%d, Q= %d\012", v0x3c47fc90_0, v0x3c47fe40_0 {0 0 0};
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x3c47ff40_0, 0, 1;
    %delay 650000, 0;
    %vpi_call/w 3 31 "$finish" {0 0 0};
    %end;
    .thread T_5;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "testbench.sv";
    "design.sv";

#! /usr/local/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/local/lib/ivl/system.vpi";
:vpi_module "/usr/local/lib/ivl/vhdl_sys.vpi";
:vpi_module "/usr/local/lib/ivl/vhdl_textio.vpi";
:vpi_module "/usr/local/lib/ivl/v2005_math.vpi";
:vpi_module "/usr/local/lib/ivl/va_math.vpi";
:vpi_module "/usr/local/lib/ivl/v2009.vpi";
S_0x36c955a0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x36c95730 .scope module, "stimulus" "stimulus" 3 3;
 .timescale -9 -12;
v0x36ca68b0_0 .var "CLK", 0 0;
v0x36ca6980_0 .net "Q", 3 0, v0x36ca6770_0;  1 drivers
S_0x36c70580 .scope module, "COUNT" "ring_counter" 3 7, 4 3 0, S_0x36c95730;
 .timescale -9 -12;
    .port_info 0 /OUTPUT 4 "q";
    .port_info 1 /INPUT 1 "clk";
v0x36c95e40_0 .net "clk", 0 0, v0x36ca68b0_0;  1 drivers
v0x36ca6770_0 .var "q", 3 0;
E_0x36c707a0 .event posedge, v0x36c95e40_0;
    .scope S_0x36c70580;
T_0 ;
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x36ca6770_0, 0, 4;
    %end;
    .thread T_0, $init;
    .scope S_0x36c70580;
T_1 ;
    %wait E_0x36c707a0;
    %load/vec4 v0x36ca6770_0;
    %dup/vec4;
    %pushi/vec4 1, 0, 4;
    %cmp/u;
    %jmp/1 T_1.0, 6;
    %dup/vec4;
    %pushi/vec4 2, 0, 4;
    %cmp/u;
    %jmp/1 T_1.1, 6;
    %dup/vec4;
    %pushi/vec4 4, 0, 4;
    %cmp/u;
    %jmp/1 T_1.2, 6;
    %dup/vec4;
    %pushi/vec4 8, 0, 4;
    %cmp/u;
    %jmp/1 T_1.3, 6;
    %jmp T_1.4;
T_1.0 ;
    %pushi/vec4 2, 0, 4;
    %store/vec4 v0x36ca6770_0, 0, 4;
    %jmp T_1.4;
T_1.1 ;
    %pushi/vec4 4, 0, 4;
    %store/vec4 v0x36ca6770_0, 0, 4;
    %jmp T_1.4;
T_1.2 ;
    %pushi/vec4 8, 0, 4;
    %store/vec4 v0x36ca6770_0, 0, 4;
    %jmp T_1.4;
T_1.3 ;
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x36ca6770_0, 0, 4;
    %jmp T_1.4;
T_1.4 ;
    %pop/vec4 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x36c95730;
T_2 ;
    %vpi_call/w 3 11 "$monitor", $time, "Q = %b\012", v0x36ca6980_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x36ca68b0_0, 0, 1;
    %delay 100000, 0;
    %vpi_call/w 3 16 "$finish" {0 0 0};
    %end;
    .thread T_2;
    .scope S_0x36c95730;
T_3 ;
    %delay 10000, 0;
    %load/vec4 v0x36ca68b0_0;
    %inv;
    %store/vec4 v0x36ca68b0_0, 0, 1;
    %jmp T_3;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "testbench.sv";
    "design.sv";

#! /usr/local/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/local/lib/ivl/system.vpi";
:vpi_module "/usr/local/lib/ivl/vhdl_sys.vpi";
:vpi_module "/usr/local/lib/ivl/vhdl_textio.vpi";
:vpi_module "/usr/local/lib/ivl/v2005_math.vpi";
:vpi_module "/usr/local/lib/ivl/va_math.vpi";
:vpi_module "/usr/local/lib/ivl/v2009.vpi";
S_0x13038df0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x13038f80 .scope module, "stimulus" "stimulus" 3 3;
 .timescale -9 -12;
v0x1304bbd0_0 .var "IN", 0 0;
v0x1304bca0_0 .net "OUT", 3 0, v0x1304b980_0;  1 drivers
v0x1304bd70_0 .var "S", 1 0;
S_0x13013580 .scope module, "UUT" "demux" 3 8, 4 3 0, S_0x13038f80;
 .timescale -9 -12;
    .port_info 0 /OUTPUT 4 "out";
    .port_info 1 /INPUT 1 "in";
    .port_info 2 /INPUT 2 "s";
v0x13039990_0 .net "in", 0 0, v0x1304bbd0_0;  1 drivers
v0x1304b980_0 .var "out", 3 0;
v0x1304ba60_0 .net "s", 1 0, v0x1304bd70_0;  1 drivers
E_0x130137b0 .event anyedge, v0x1304ba60_0, v0x13039990_0;
    .scope S_0x13013580;
T_0 ;
    %wait E_0x130137b0;
    %load/vec4 v0x1304ba60_0;
    %dup/vec4;
    %pushi/vec4 0, 0, 2;
    %cmp/u;
    %jmp/1 T_0.0, 6;
    %dup/vec4;
    %pushi/vec4 1, 0, 2;
    %cmp/u;
    %jmp/1 T_0.1, 6;
    %dup/vec4;
    %pushi/vec4 2, 0, 2;
    %cmp/u;
    %jmp/1 T_0.2, 6;
    %dup/vec4;
    %pushi/vec4 3, 0, 2;
    %cmp/u;
    %jmp/1 T_0.3, 6;
    %pushi/vec4 0, 15, 4;
    %store/vec4 v0x1304b980_0, 0, 4;
    %jmp T_0.5;
T_0.0 ;
    %pushi/vec4 0, 7, 3;
    %load/vec4 v0x13039990_0;
    %concat/vec4; draw_concat_vec4
    %store/vec4 v0x1304b980_0, 0, 4;
    %jmp T_0.5;
T_0.1 ;
    %pushi/vec4 0, 3, 2;
    %load/vec4 v0x13039990_0;
    %concat/vec4; draw_concat_vec4
    %concati/vec4 0, 1, 1;
    %store/vec4 v0x1304b980_0, 0, 4;
    %jmp T_0.5;
T_0.2 ;
    %pushi/vec4 0, 1, 1;
    %load/vec4 v0x13039990_0;
    %concat/vec4; draw_concat_vec4
    %concati/vec4 0, 3, 2;
    %store/vec4 v0x1304b980_0, 0, 4;
    %jmp T_0.5;
T_0.3 ;
    %load/vec4 v0x13039990_0;
    %concati/vec4 0, 7, 3;
    %store/vec4 v0x1304b980_0, 0, 4;
    %jmp T_0.5;
T_0.5 ;
    %pop/vec4 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x13038f80;
T_1 ;
    %vpi_call/w 3 13 "$monitor", $time, "I = %b, S = %b, OUT = %b\012", v0x1304bbd0_0, v0x1304bd70_0, v0x1304bca0_0 {0 0 0};
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x1304bbd0_0, 0, 1;
    %pushi/vec4 0, 0, 2;
    %store/vec4 v0x1304bd70_0, 0, 2;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 2;
    %store/vec4 v0x1304bd70_0, 0, 2;
    %delay 10000, 0;
    %pushi/vec4 2, 0, 2;
    %store/vec4 v0x1304bd70_0, 0, 2;
    %delay 10000, 0;
    %pushi/vec4 3, 0, 2;
    %store/vec4 v0x1304bd70_0, 0, 2;
    %delay 40000, 0;
    %vpi_call/w 3 20 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "testbench.sv";
    "design.sv";

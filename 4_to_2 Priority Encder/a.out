#! /usr/local/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/local/lib/ivl/system.vpi";
:vpi_module "/usr/local/lib/ivl/vhdl_sys.vpi";
:vpi_module "/usr/local/lib/ivl/vhdl_textio.vpi";
:vpi_module "/usr/local/lib/ivl/v2005_math.vpi";
:vpi_module "/usr/local/lib/ivl/va_math.vpi";
:vpi_module "/usr/local/lib/ivl/v2009.vpi";
S_0x13c301e0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x13c41ef0 .scope module, "stimulus" "stimulus" 3 3;
 .timescale -9 -12;
v0x13c57360_0 .var "IN", 3 0;
v0x13c57420_0 .net "OUT", 1 0, v0x13c570b0_0;  1 drivers
v0x13c574f0_0 .net "V", 0 0, L_0x13c57b30;  1 drivers
S_0x13c42080 .scope module, "ENCODER" "encoder" 3 8, 4 3 0, S_0x13c41ef0;
 .timescale -9 -12;
    .port_info 0 /OUTPUT 2 "out";
    .port_info 1 /OUTPUT 1 "v";
    .port_info 2 /INPUT 4 "in";
L_0x13c57760 .functor OR 1, L_0x13c575f0, L_0x13c576c0, C4<0>, C4<0>;
L_0x13c579d0 .functor OR 1, L_0x13c57760, L_0x13c578a0, C4<0>, C4<0>;
L_0x13c57b30 .functor OR 1, L_0x13c579d0, L_0x13c57a90, C4<0>, C4<0>;
v0x13c42a70_0 .net *"_ivl_1", 0 0, L_0x13c575f0;  1 drivers
v0x13c56b10_0 .net *"_ivl_11", 0 0, L_0x13c57a90;  1 drivers
v0x13c56bf0_0 .net *"_ivl_3", 0 0, L_0x13c576c0;  1 drivers
v0x13c56ce0_0 .net *"_ivl_4", 0 0, L_0x13c57760;  1 drivers
v0x13c56dc0_0 .net *"_ivl_7", 0 0, L_0x13c578a0;  1 drivers
v0x13c56ef0_0 .net *"_ivl_8", 0 0, L_0x13c579d0;  1 drivers
v0x13c56fd0_0 .net "in", 3 0, v0x13c57360_0;  1 drivers
v0x13c570b0_0 .var "out", 1 0;
v0x13c57190_0 .net "v", 0 0, L_0x13c57b30;  alias, 1 drivers
E_0x13c422b0 .event anyedge, v0x13c56fd0_0;
L_0x13c575f0 .part v0x13c57360_0, 0, 1;
L_0x13c576c0 .part v0x13c57360_0, 1, 1;
L_0x13c578a0 .part v0x13c57360_0, 2, 1;
L_0x13c57a90 .part v0x13c57360_0, 3, 1;
    .scope S_0x13c42080;
T_0 ;
    %wait E_0x13c422b0;
    %load/vec4 v0x13c56fd0_0;
    %dup/vec4;
    %pushi/vec4 15, 7, 4;
    %cmp/x;
    %jmp/1 T_0.0, 4;
    %dup/vec4;
    %pushi/vec4 7, 3, 4;
    %cmp/x;
    %jmp/1 T_0.1, 4;
    %dup/vec4;
    %pushi/vec4 3, 1, 4;
    %cmp/x;
    %jmp/1 T_0.2, 4;
    %dup/vec4;
    %pushi/vec4 1, 0, 4;
    %cmp/x;
    %jmp/1 T_0.3, 4;
    %vpi_call/w 4 16 "$display", "Unspecified signal" {0 0 0};
    %jmp T_0.5;
T_0.0 ;
    %pushi/vec4 3, 0, 2;
    %store/vec4 v0x13c570b0_0, 0, 2;
    %jmp T_0.5;
T_0.1 ;
    %pushi/vec4 2, 0, 2;
    %store/vec4 v0x13c570b0_0, 0, 2;
    %jmp T_0.5;
T_0.2 ;
    %pushi/vec4 1, 0, 2;
    %store/vec4 v0x13c570b0_0, 0, 2;
    %jmp T_0.5;
T_0.3 ;
    %pushi/vec4 0, 0, 2;
    %store/vec4 v0x13c570b0_0, 0, 2;
    %jmp T_0.5;
T_0.5 ;
    %pop/vec4 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x13c41ef0;
T_1 ;
    %vpi_call/w 3 13 "$monitor", $time, "IN = %b, V = %b, OUT = %b\012", v0x13c57360_0, v0x13c574f0_0, v0x13c57420_0 {0 0 0};
    %delay 10000, 0;
    %pushi/vec4 11, 0, 4;
    %store/vec4 v0x13c57360_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 3, 0, 4;
    %store/vec4 v0x13c57360_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x13c57360_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 11, 0, 4;
    %store/vec4 v0x13c57360_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 4, 0, 4;
    %store/vec4 v0x13c57360_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x13c57360_0, 0, 4;
    %delay 10000, 0;
    %vpi_call/w 3 22 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "testbench.sv";
    "design.sv";
